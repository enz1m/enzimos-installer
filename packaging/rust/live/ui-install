#!/usr/bin/bash
# SPDX-License-Identifier: MIT
set -euo pipefail
[[ $# == 0 ]] || exit 2
export PATH=/usr/bin LC_ALL=C
# Keep a root-readable copy of everything the installer prints (the failure banner
# points here, and it can be followed over SSH on development media); the graphical
# installer still reads stdout and stderr separately.
log=/run/enzimos-install.log
: > "$log"
chmod 0644 "$log"
/usr/lib/enzimos-installer/enzimos-installer-native install-ui-from-stdin \
    2> >(tee -a "$log" >&2) | tee -a "$log"
