Window.SetBackgroundTopColor(0.94, 0.95, 0.98);
Window.SetBackgroundBottomColor(0.94, 0.95, 0.98);
width=Window.GetWidth(); height=Window.GetHeight();
track=Sprite(Image("progress-track.png"));
track.SetPosition(width/2-150,height*0.53,1);
fill_image=Image("progress-center.png");
fill=Sprite(fill_image);
fill.SetPosition(width/2-147,height*0.53,2);
fill_left=Sprite(Image("progress-left.png"));
fill_right=Sprite(Image("progress-right.png"));
fill_left.SetPosition(width/2-150,height*0.53,2);
fun draw_fill(pixels) {
    # Scale only the straight section; the circular endcaps keep their geometry.
    if (pixels<7) pixels=7;
    fill.SetImage(fill_image.Scale(pixels-6,6));
    fill_right.SetPosition(width/2-150+pixels-3,height*0.53,2);
}
draw_fill(7);
mode="boot"; target=0.01; shown=0.01; repaint_ticks=0;
last_prompt=""; submitted_prompt=""; last_bullets=0; retry=0;
status=Sprite(); status.SetOpacity(0);
password_box_image=Image("password-box.png");
password_box=Sprite(password_box_image);
password_box.SetPosition(width/2-170,height*0.54,0);password_box.SetOpacity(0);
for (i=0;i<40;i++) {password_dot[i]=Sprite(Image("dot.png"));password_dot[i].SetOpacity(0);}
fun message(text) {
    if (mode=="password" && retry) status_image=Image.Text(text,0.70,0.18,0.22,1,"Sans 14");
    else status_image=Image.Text(text,0.38,0.42,0.50,1,"Sans 14");
    global.status_image=status_image;
    status.SetImage(status_image);
    status.SetPosition((width-status_image.GetWidth())/2,height*0.46,2);
    status.SetOpacity(1);
}
fun progress(duration,percent) {
    # Plymouth estimates this from the boot profile and actual boot milestones.
    # Never regress or claim completion before the splash is dismissed.
    if (percent>0.98) percent=0.98;
    if (percent>target) target=percent;
}
fun refresh() {
    if (mode=="boot") {
        shown=shown+(target-shown)*0.12;
        pixels=Math.Int(300*shown);
        draw_fill(pixels);
        track.SetOpacity(1);fill.SetOpacity(1);
        fill_left.SetOpacity(1);fill_right.SetOpacity(1);
    } else {
        track.SetOpacity(0);fill.SetOpacity(0);fill_left.SetOpacity(0);fill_right.SetOpacity(0);
        # KMS may replace the firmware framebuffer after the first prompt.
        # SetImage marks the sprite's damage region even when pixels are unchanged.
        if (mode=="password") {
            # A renderer modeset can clear the scanout after the initial prompt.
            # Repaint the static scene occasionally, without animating the wait.
            repaint_ticks++;
            if (repaint_ticks>=30) {
                Window.SetBackgroundTopColor(0.94, 0.95, 0.98);
                repaint_ticks=0;
            }
            status.SetImage(global.status_image);
            password_box.SetImage(password_box_image);
        }
    }
}
fun password(prompt,bullets) {
    if (mode!="password") {
        retry=(submitted_prompt!="" && submitted_prompt==prompt);
        last_prompt=prompt;
    }
    mode="password";last_bullets=bullets;
    if (retry) message("Disk did not unlock. Check your passphrase and try again.");
    else message("Unlock your encrypted disk");
    password_box.SetOpacity(1);
    count=bullets;if (count>36) count=36;
    for (i=0;i<40;i++) {
        password_dot[i].SetOpacity(i<count);
        password_dot[i].SetPosition(width/2-(count*9-1)/2+i*9,height*0.54+20,2);
    }
}
fun normal() {
    if (mode=="password" && last_bullets>0) submitted_prompt=last_prompt;
    mode="boot";status.SetOpacity(0);password_box.SetOpacity(0);
    for (i=0;i<40;i++) password_dot[i].SetOpacity(0);
}
fun question(prompt,entry) {mode="question";message(prompt+"\n"+entry);}
fun display_message(text) {if (mode!="boot") message(text);}
fun quit() {if (mode=="boot") draw_fill(300);}
Plymouth.SetRefreshFunction(refresh);
Plymouth.SetBootProgressFunction(progress);
Plymouth.SetDisplayPasswordFunction(password);
Plymouth.SetDisplayQuestionFunction(question);
Plymouth.SetDisplayNormalFunction(normal);
Plymouth.SetDisplayMessageFunction(display_message);
Plymouth.SetQuitFunction(quit);

fun system_update(percent) { progress(0,percent/100); }
Plymouth.SetSystemUpdateFunction(system_update);
